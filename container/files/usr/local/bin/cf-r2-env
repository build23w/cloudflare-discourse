# sourced by the backup/restore/asset-cache scripts.
# Uses CF_R2_* (our plumbing) — NOT Discourse's own S3 settings, which live in the
# database so a migrated forum keeps pointing at its existing uploads bucket.
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="${CF_R2_ACCESS_KEY_ID:-}"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="${CF_R2_SECRET_ACCESS_KEY:-}"
export RCLONE_CONFIG_R2_ENDPOINT="${CF_R2_ENDPOINT:-}"
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
export CF_BACKUP_BUCKET="${CF_R2_BACKUPS_BUCKET:-discourse-backups}"
