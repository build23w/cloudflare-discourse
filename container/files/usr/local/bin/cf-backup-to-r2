#!/bin/bash
# pg_dump -> gzip -> R2. Runs every 15 min, plus once more on SIGTERM.
set -uo pipefail
source /usr/local/bin/cf-r2-env

if [ -z "$RCLONE_CONFIG_R2_ACCESS_KEY_ID" ]; then
  echo "[cf-backup] no R2 credentials in env — skipping backup"
  exit 0
fi

ts=$(date -u +%Y%m%d-%H%M%S)
tmp=/tmp/cf-pg-backup.sql.gz
sudo -u postgres pg_dump --clean --if-exists discourse | gzip > "$tmp" || { echo "[cf-backup] pg_dump failed"; exit 1; }
[ -s "$tmp" ] || { echo "[cf-backup] empty dump — refusing to upload"; exit 1; }

rclone copyto "$tmp" "r2:${CF_BACKUP_BUCKET}/pg/backup-${ts}.sql.gz" || exit 1
rclone copyto "$tmp" "r2:${CF_BACKUP_BUCKET}/pg/latest.sql.gz" || exit 1
rclone delete "r2:${CF_BACKUP_BUCKET}/pg" --include "backup-*" --min-age 14d 2>/dev/null || true
echo "[cf-backup] uploaded pg/backup-${ts}.sql.gz ($(du -h "$tmp" | cut -f1))"
