#!/bin/bash
# extract|upload precompiled assets to/from R2, keyed by Discourse SHA + plugin set,
# so a full ember build happens only when the forum or its plugins actually change.
set -uo pipefail
source /usr/local/bin/cf-r2-env
cd /var/www/discourse
sha=$(git rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
plugins=$(ls -1 plugins 2>/dev/null | sort | md5sum | cut -c1-8)
# Bump CACHE_EPOCH to invalidate every stored bundle at once. v1 bundles served an
# incomplete asset set: JSON and the crawler view worked while every Ember page
# returned 500 from the app layout.
CACHE_EPOCH=v2
key="r2:${CF_BACKUP_BUCKET}/assets-cache/${CACHE_EPOCH}-assets-${sha}-${plugins}.tar.gz"

# Everything the layout resolves at render time. The ember dist directory is included
# when the build produces one; maps/brotli variants live inside public/assets already.
asset_paths() {
  echo public/assets
  [ -d app/assets/javascripts/discourse/dist ] && echo app/assets/javascripts/discourse/dist
}

# Minimal definition of "usable": the sprockets manifest the layout consults, plus a
# non-trivial number of compiled files.
assets_look_complete() {
  ls public/assets/.sprockets-manifest*.json >/dev/null 2>&1 || return 1
  [ "$(ls -1 public/assets 2>/dev/null | wc -l)" -gt 10 ] || return 1
}

case "${1:-}" in
  extract)
    [ -n "$RCLONE_CONFIG_R2_ACCESS_KEY_ID" ] || exit 1
    command -v rclone >/dev/null 2>&1 || exit 1
    b=$(rclone size "$key" --json 2>/dev/null | grep -o '"bytes":[0-9-]*' | cut -d: -f2)
    { [ -n "${b:-}" ] && [ "${b:-0}" -gt 0 ] 2>/dev/null; } || { echo "[cf-assets] no cache for ${CACHE_EPOCH}-${sha}-${plugins}"; exit 1; }
    rclone cat "$key" | tar xzf - -C /var/www/discourse || exit 1
    if ! assets_look_complete; then
      echo "[cf-assets] cached archive is incomplete — discarding, will precompile"
      exit 1
    fi
    chown -R discourse:www-data public/assets app/assets/javascripts/discourse/dist 2>/dev/null || true
    echo "[cf-assets] extracted cache ${CACHE_EPOCH}-${sha}-${plugins}"
    ;;
  upload)
    [ -n "$RCLONE_CONFIG_R2_ACCESS_KEY_ID" ] || exit 0
    command -v rclone >/dev/null 2>&1 || exit 0
    # Never publish a bundle that would not boot; a bad cache poisons every later start.
    if ! assets_look_complete; then
      echo "[cf-assets] refusing to cache an incomplete build"
      exit 1
    fi
    # shellcheck disable=SC2046
    tar czf /tmp/cf-assets.tgz -C /var/www/discourse $(asset_paths) || exit 1
    rclone copyto /tmp/cf-assets.tgz "$key" || exit 1
    rclone delete "r2:${CF_BACKUP_BUCKET}/assets-cache" --min-age 30d 2>/dev/null || true
    echo "[cf-assets] uploaded cache ${CACHE_EPOCH}-${sha}-${plugins} ($(du -h /tmp/cf-assets.tgz | cut -f1))"
    ;;
  *)
    echo "usage: cf-assets-cache extract|upload"; exit 2 ;;
esac
